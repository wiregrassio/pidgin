<?xml version="1.0" encoding="UTF-8"?>
<!--
  Sprint Plan Template
  Generated by /new-sprint against design.md and context/.
  Do not hand-edit — re-run /new-sprint if the design changes.
-->
<sprint name="" version="">
  <summary>
    <!-- One-line goal. Number of missions. Expected duration. -->
  </summary>

  <decision_points>
    <!--
      Decision points the operator must resolve before /run-sprint.
      Default answers where possible.
    -->
    <dp id="1" default=""><!-- question --></dp>
  </decision_points>

  <missions>
    <!--
      Each mission is self-contained. The executor receives ONLY the
      <mission> element. No external context. Everything the executor
      needs is inside the mission.

      Attributes:
        n        — mission number (1-indexed)
        tier     — scout | execute | reason
        review   — true | false

      Inner tags conform to rf-edge/marionette/mission-grammar.md:
        <context>       — orientation, prior work, what this changes
        <objective>     — numbered high-level goals
        <specification> — detailed technical spec
        <steps>         — ordered execution steps (RUN/Read/Write/Edit
                          with EXPECT/FAIL)
        <report>        — what the structured report must cover
    -->
    <mission n="1" tier="execute" review="true">
      <context>...</context>
      <objective>...</objective>
      <specification>...</specification>
      <steps>...</steps>
      <report>...</report>
    </mission>

    <mission n="2" tier="execute" review="true">
      <context>...</context>
      <objective>...</objective>
      <specification>...</specification>
      <steps>...</steps>
      <report>...</report>
    </mission>
  </missions>
</sprint>
